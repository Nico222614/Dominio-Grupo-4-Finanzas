    "# ==========================================================\n",
    "# FASE 3 (B): VALIDACIÓN Y ANÁLISIS - BANDAS DE ERROR\n",
    "# ==========================================================\n",
    "\n",
    "def ejecutar_validacion_bandas(df_muestra, X, Y):\n",
    "    \"\"\"\n",
    "    Esta función calcula la validación del modelo de tendencia\n",
    "    utilizando los precios máximos (High) y mínimos (Low) como \n",
    "    bandas de error para verificar qué tanto se aleja la tendencia.\n",
    "    \"\"\"\n",
    "    \n",
    "    # 1. Calculamos la tendencia (Mínimos Cuadrados) para la gráfica\n",
    "    # Usamos np.polyfit para obtener la pendiente y la intersección\n",
    "    pendiente, interseccion = np.polyfit(X, Y, 1)\n",
    "    y_tendencia = np.polyval([pendiente, interseccion], X)\n",
    "    \n",
    "    # 2. Configuración de la gráfica\n",
    "    plt.figure(figsize=(12, 6))\n",
